// OctoFriend MCP Configuration
// Place this at ~/.config/octofriend/octofriend.json5

{
  mcpServers: {
    // Archon Codebase Intelligence - STDIO transport (ADR-003)
    archon: {
      command: "docker",
      args: ["exec", "-i", "archon", "python", "-m", "src.mcp_server.mcp_server_stdio"],
      type: "stdio",
    },
  },
}
