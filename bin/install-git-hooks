#!/usr/bin/env bash
#
# Install Git Hooks
#
# Copies git hooks from the repo's hooks/ directory to .git/hooks/
# This makes them version-controlled while still being executable by git.
#
# Usage: bin/install-git-hooks

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
HOOKS_DIR="$REPO_ROOT/hooks"
GIT_HOOKS_DIR="$REPO_ROOT/.git/hooks"

if [[ ! -d "$HOOKS_DIR" ]]; then
    echo "Error: hooks directory not found at $HOOKS_DIR"
    exit 1
fi

mkdir -p "$GIT_HOOKS_DIR"

echo "Installing git hooks from $HOOKS_DIR..."

for hook in "$HOOKS_DIR"/*; do
    if [[ -f "$hook" ]]; then
        hook_name=$(basename "$hook")
        cp "$hook" "$GIT_HOOKS_DIR/$hook_name"
        chmod +x "$GIT_HOOKS_DIR/$hook_name"
        echo "  ✓ Installed $hook_name"
    fi
done

echo ""
echo "✓ Git hooks installed successfully"
echo ""
echo "To verify, run: ls -la .git/hooks/"
